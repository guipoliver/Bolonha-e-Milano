@startuml
left to right direction
skinparam shadowing false
skinparam usecase {
  BackgroundColor #F7F8FC
  BorderColor #232A60
}
actor Jogador
rectangle "Bolonha e Milano" {
  usecase "Acessar agricultura" as B
  usecase "Colher (processar safra)" as O0
  usecase "Distribuir alimentos" as O1
}
Jogador --> B
O0 .> B : <<extend>>
O1 .> B : <<extend>>
@enduml
